# The tutorial worker: a Linux box running `flightdeck worker`, which the
# FlightDeck Desktop in the macOS tutorial VM pairs with.
#
# The build context is staged by tutorials/worker/up.sh: the Linux binary
# from tutorials/worker/build-binary.sh plus tutorials/projects/. Use up.sh.
FROM docker.io/library/node:22-bookworm-slim

# What a developer's worker box would have: git for worktrees, a shell, and
# the usual tools agents reach for.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ca-certificates curl ripgrep less procps zsh nano python3 openssh-server \
    && rm -rf /var/lib/apt/lists/*

# The agent the tutorials drive.
RUN npm install -g @anthropic-ai/claude-code

# A plain non-root developer account; the videos show its prompt and paths.
RUN useradd --create-home --shell /usr/bin/zsh dev \
    && mkdir -p /srv/git && chown dev:dev /srv/git
COPY --chown=dev:dev home/ /home/dev/

# The real binary, behind a wrapper: the debug worker listens on 0.0.0.0, so
# `worker pair`/`status` would print that as its address; a real worker
# prints its own name. The wrapper shows this box's name, devbox, instead.
COPY flightdeck /usr/local/lib/flightdeck/flightdeck
COPY bin/flightdeck bin/worker-start /usr/local/bin/
# FlightDeck Web's files. A debug build does not embed them: rust-embed reads
# them at run time from where they were at build time (/src in
# build-binary.sh's container), so they go there.
COPY webui-dist /src/webui/dist

USER dev
WORKDIR /home/dev
RUN git config --global user.name "Dev" \
    && git config --global user.email "dev@example.com" \
    && git config --global init.defaultBranch main

# The mock projects (tutorials/projects/*), each a git repo with one commit,
# in ~/flightdeck: the folder the worker's Open Project list shows.
COPY --chown=dev:dev projects /home/dev/flightdeck
# Each also gets an `origin`: a bare repository in /srv/git, standing in for
# GitHub, so Push and Pull base have somewhere to go.
RUN for p in /home/dev/flightdeck/*/; do \
        name="$(basename "$p")" \
        && git -C "$p" init -q && git -C "$p" add -A \
        && git -C "$p" commit -q -m "Initial commit" \
        && git clone -q --bare "$p" "/srv/git/$name.git" \
        && git -C "$p" remote add origin "/srv/git/$name.git" \
        && git -C "$p" fetch -q origin && git -C "$p" branch -q -u origin/main main; \
    done

# SSH on port 2222, unprivileged: sshd runs as dev and only lets dev in (the
# key the tutorial VM uses is added by tutorials/prepare.sh).
RUN mkdir -p /home/dev/.sshd /home/dev/.ssh && chmod 700 /home/dev/.ssh \
    && ssh-keygen -q -t ed25519 -N '' -f /home/dev/.sshd/host_ed25519 \
    && printf '%s\n' 'Port 2222' 'HostKey /home/dev/.sshd/host_ed25519' \
        'PidFile /home/dev/.sshd/sshd.pid' 'UsePAM no' 'PasswordAuthentication no' \
        'KbdInteractiveAuthentication no' 'PrintMotd no' 'PrintLastLog no' \
        'AuthorizedKeysFile .ssh/authorized_keys' > /home/dev/.sshd/sshd_config

# No "agent finished" notifications: the Mac would show them over the
# toolbar (where Finish is), and a click opens Script Editor.
RUN mkdir -p /home/dev/.flightdeck \
    && printf '[notifications]\nenabled = false\n' > /home/dev/.flightdeck/config.toml

# All of Claude Code's state, the login and its first-run answers
# (.claude.json) included, in ~/.claude: up.sh keeps that in a named volume,
# so a fresh container needs no login and shows no first-run screens.
ENV CLAUDE_CONFIG_DIR=/home/dev/.claude
ENV SHELL=/usr/bin/zsh
# The update check caches under $XDG_CACHE_HOME, else ~/Library/Application
# Support even on Linux (remote-control-5ggx): keep Library/ out of the video.
ENV XDG_CACHE_HOME=/home/dev/.cache

# Debug-build seam: listen here instead of on Tailscale addresses.
ENV FLIGHTDECK_WORKER_TEST_LISTEN=0.0.0.0:7420
EXPOSE 7420 2222
CMD ["worker-start"]
