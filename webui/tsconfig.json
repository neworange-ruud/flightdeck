{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* D15 requires `tsc --noEmit` to run clean in CI/local gates — every
       strictness flag below is load-bearing, not aspirational. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,

    /* `node` is needed by `vite.config.ts` (which imports `node:fs`) and by the
       palette guard test, which reads the source tree off disk. */
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e"
  ]
}
