# OPTIONAL reference base image for the Cursor CLI agent (SPECS §31).
#
# Not needed for the default flow — `flightdeck image build cursor` builds a
# self-contained image from docker.io/library/node. Use this only to pre-build a
# base and point `execution.base_image` at it.
#
#   podman build -t flightdeck-cursor-base:latest -f containers/Containerfile.cursor containers
#
# See Containerfile.claude for the base-image contract.
FROM docker.io/library/node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ca-certificates curl ripgrep less zsh \
    && rm -rf /var/lib/apt/lists/*

# Install the Cursor CLI. There is no npm package: the official installer
# downloads a release tarball into $HOME/.local. This runs as root, before the
# `agent` user exists, so point it at a neutral prefix and symlink the binary
# onto the PATH every user shares.
RUN mkdir -p /opt/cursor \
    && curl -fsS https://cursor.com/install | HOME=/opt/cursor bash \
    && ln -sf /opt/cursor/.local/bin/cursor-agent /usr/local/bin/cursor-agent \
    && chmod -R a+rX /opt/cursor

RUN useradd --create-home --shell /usr/bin/zsh agent \
    && mkdir -p /home/agent/.local/state /home/agent/.local/share /home/agent/.config /home/agent/.cache \
    && chmod -R 0777 /home/agent
USER agent
WORKDIR /workspace
