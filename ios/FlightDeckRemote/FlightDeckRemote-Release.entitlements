<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs entitlement (PRD §9.1) — Release builds (TestFlight + App Store).

	  TestFlight and App Store builds are signed with a distribution profile,
	  which grants `aps-environment: production`. This file must say the same or
	  codesign fails. See FlightDeckRemote.entitlements for the Debug counterpart
	  and the full rationale.

	  Getting this wrong is SILENT at build time and only shows up as "testers
	  never receive notifications": a Release build's `PushEnvironment.current`
	  reports `.production`, so the relay pushes to api.push.apple.com, and a
	  token minted under the sandbox environment would be rejected there.
	-->
	<key>aps-environment</key>
	<string>production</string>
	<!--
	  Sharing with the Notification Service Extension (remote-control-bza0).

	  keychain-access-groups: the FIRST entry is the app's own application
	  identifier, which is exactly the default group items were written to
	  before this entitlement existed, so every existing item (identity key,
	  relay password) stays where it is and is still found. The second entry is
	  the group the extension can read: KeychainStore writes ONLY the
	  key-agreement key and the pairing records there
	  (SharedContainer.accessGroup), and the app moves existing copies of those
	  into it at launch (SharedStorageMigration) so nobody has to re-pair.
	  Keychain groups need no developer-portal registration (profiles carry
	  the TEAMID.* wildcard).

	  application-groups: the shared UserDefaults suite for the notification
	  preferences the extension applies. The App Group MUST be registered for
	  team 7NKCS4AZS9, enabled on this App ID and the extension's, and present
	  in the signing profiles — see ios/README.md.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)agency.neworange.flightdeck.remote</string>
		<string>$(AppIdentifierPrefix)agency.neworange.flightdeck.remote.shared</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.agency.neworange.flightdeck.remote</string>
	</array>
</dict>
</plist>
