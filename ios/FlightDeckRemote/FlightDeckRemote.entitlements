<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs entitlement (PRD §9.1) — Debug/development builds.

	  `aps-environment` must MATCH what the signing provisioning profile grants;
	  the profile does not override it. A development profile grants
	  `development`; an App Store / TestFlight distribution profile grants
	  `production`, and signing a distribution build with `development` here
	  fails ("provisioning profile does not match the entitlements"). Release
	  builds therefore use FlightDeckRemote-Release.entitlements, wired
	  per-configuration in project.yml.

	  The Swift side agrees: `PushEnvironment.current` reports `.sandbox` in
	  DEBUG and `.production` otherwise, and the relay picks the APNs host from
	  whatever the device reports (`apns.rs`).

	  This entitlement only takes effect in a SIGNED build. The unsigned
	  simulator build (CODE_SIGNING_ALLOWED=NO) skips codesign entirely, so it is
	  inert there and does not break that build.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  Sharing with the Notification Service Extension (remote-control-bza0).

	  keychain-access-groups: the FIRST entry is the app's own application
	  identifier, which is exactly the default group items were written to
	  before this entitlement existed, so every existing item (identity key,
	  relay password) stays where it is and is still found. The second entry is
	  the group the extension can read: KeychainStore writes ONLY the
	  key-agreement key and the pairing records there
	  (SharedContainer.accessGroup), and the app moves existing copies of those
	  into it at launch (SharedStorageMigration) so nobody has to re-pair.
	  Keychain groups need no developer-portal registration (profiles carry
	  the TEAMID.* wildcard).

	  application-groups: the shared UserDefaults suite for the notification
	  preferences the extension applies. The App Group MUST be registered for
	  team 7NKCS4AZS9, enabled on this App ID and the extension's, and present
	  in the signing profiles — see ios/README.md.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)agency.neworange.flightdeck.remote</string>
		<string>$(AppIdentifierPrefix)agency.neworange.flightdeck.remote.shared</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.agency.neworange.flightdeck.remote</string>
	</array>
	<!--
	  Time Sensitive Notifications (remote-control-bza0): lets a *needs input*
	  notification (interruption level time-sensitive — set by the relay's APNs
	  payload and by the Notification Service Extension) break through Focus and
	  the scheduled summary. Without it iOS silently presents those as `active`.
	  The capability must be enabled on the App ID and present in the signing
	  profile (regenerate the manual App Store profile) — see ios/README.md.
	-->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
