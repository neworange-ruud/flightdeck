<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX v3 installer for flightdeck-desktop, driven by cargo-wix (`cargo wix -p flightdeck-desktop`).
  Per-machine install to Program Files, Start-menu shortcut, Add/Remove Programs entry, and
  in-place upgrades. Unsigned by default; signing is a separate step (see desktop/PACKAGING.md).
  NOT built in the authoring environment (no Windows machine); built by the `package` job in
  .github/workflows/desktop.yml. The UpgradeCode GUID identifies the product line across
  versions: never change it. cargo-wix substitutes $(var.Version) etc. from Cargo.toml.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="FlightDeck" UpgradeCode="6D0B5A57-6B0C-4F3E-9C55-2E1F3A6B7D10"
           Manufacturer="New Orange" Language="1033" Codepage="1252" Version="$(var.Version)">
    <Package Id="*" Keywords="Installer" Manufacturer="New Orange" InstallerVersion="450"
             Languages="1033" Compressed="yes" InstallScope="perMachine" SummaryCodepage="1252"
             Description="FlightDeck desktop app"/>

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of FlightDeck is already installed."/>
    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1"/>
    <Property Id="DiskPrompt" Value="FlightDeck Installation"/>
    <Icon Id="FlightDeckIcon" SourceFile="$(sys.SOURCEFILEDIR)..\packaging\icons\flightdeck.ico"/>
    <Property Id="ARPPRODUCTICON" Value="FlightDeckIcon"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="APPLICATIONFOLDER" Name="FlightDeck">
          <Component Id="MainExecutable" Guid="*" Win64="yes">
            <File Id="FlightDeckDesktopExe" Name="flightdeck-desktop.exe"
                  Source="$(var.CargoTargetBinDir)\flightdeck-desktop.exe" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
          <Shortcut Id="FlightDeckShortcut" Name="FlightDeck"
                    Description="Orchestrate AI coding agents"
                    Target="[APPLICATIONFOLDER]flightdeck-desktop.exe"
                    WorkingDirectory="APPLICATIONFOLDER" Icon="FlightDeckIcon"/>
          <RegistryValue Root="HKCU" Key="Software\New Orange\FlightDeck"
                         Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="FlightDeck" Level="1" ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Product>
</Wix>
